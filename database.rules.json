{
  "rules": {
    "users": {
      ".read": true,
      ".indexOn": ["full_name", "username_lower"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "usernames": {
      ".read": true,
      "$username": {
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "$username.matches(/^[a-z0-9_]{3,20}$/)"
      }
    }
  }
}
